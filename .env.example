# Copia este fichero a .env y ajusta. Cárgalo antes de arrancar:
#   Linux/macOS:  set -a; source .env; set +a
#   Windows (PowerShell): ver README

# --- Base de datos (coincide con docker-compose.yml) ---
POSTGRES_DB=taller
POSTGRES_USER=taller
POSTGRES_PASSWORD=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
# En un servidor real: DJANGO_DEBUG=0 y una clave larga y aleatoria.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=

# --- Telegram (gratis). Crea el bot hablando con @BotFather ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_USERNAME=MiTallerBot
# TELEGRAM_OWNER_CHAT_ID=      # tu chat: escribe /id a tu bot y copia el número

# --- Pedido al proveedor: outbox (prueba, por defecto) o email ---
# TALLER_SUPPLIER=email
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_USER=taller@ejemplo.com
# SMTP_PASS=
# SUPPLIER_EMAIL=pedidos@proveedor.com

# --- IA local (Ollama + Gemma). Si no está en marcha se usan reglas ---
# TALLER_MODEL=gemma3
# OLLAMA_URL=http://localhost:11434
# TALLER_NO_LLM=1
